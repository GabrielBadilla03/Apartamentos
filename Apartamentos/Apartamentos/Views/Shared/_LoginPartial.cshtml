@using Apartamentos.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <span class="username">@User.Identity?.Name</span>
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
        <button class="nav-logout" type="submit">Salir</button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login">Entrar</a>
}
