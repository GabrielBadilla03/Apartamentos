<!doctype html>
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>@ViewData["Title"] - Apartamentos</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body>
<header class="nav"><div class="nav-in"><a class="brand" asp-controller="Home" asp-action="Index">Apartamentos</a>
@if(User.Identity?.IsAuthenticated==true){
  <a asp-controller="Apartamentos" asp-action="Index">Apartamentos</a>
  <a asp-controller="Encargados" asp-action="Index">Encargados</a>
  <a asp-controller="Agua" asp-action="Index">Agua</a>
  <a asp-controller="Luz" asp-action="Index">Luz</a>
  <a asp-controller="MontosAgua" asp-action="Index">Montos agua</a>
  <a asp-controller="MontosLuz" asp-action="Index">Montos luz</a>
  @if(User.IsInRole("Administrador")){<a asp-controller="Usuarios" asp-action="Index">Usuarios</a>}
  <span class="username">@User.Identity.Name</span>
  <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post"><button class="nav-logout" type="submit">Salir</button></form>
}else{<a asp-area="Identity" asp-page="/Account/Login">Entrar</a>}
</div></header>
<main class="container">
@if(TempData["Mensaje"] is string ok){<div class="alert success" role="status">@ok</div>}
@if(TempData["Error"] is string err){<div class="alert error" role="alert">@err</div>}
@RenderBody()
</main>
<footer class="footer">Sistema de administración de apartamentos · SQL Server / ASP.NET Core</footer>
@await RenderSectionAsync("Scripts",required:false)
</body></html>