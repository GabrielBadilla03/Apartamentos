@model ApplicationUser
@{ViewData["Title"]="Restablecer clave";}
<h1>Restablecer contraseña</h1><p>@Model.Email · @Model.Nombre @Model.Apellidos</p>
<form method="post" asp-action="ResetPassword" asp-route-id="@Model.Id" class="form-card">@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="validation"></div><div class="field"><label for="nuevaPassword">Nueva contraseña</label>
<input id="nuevaPassword" name="nuevaPassword" type="password" minlength="10" required autocomplete="new-password"/></div>
<div class="actions"><button type="submit" class="btn primary">Restablecer</button><a asp-action="Index" class="btn">Cancelar</a></div></form>